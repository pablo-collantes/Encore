{
  "name": "encore",
  "version": "0.2.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "Full-stack TypeScript on Cloudflare Workers, D1 and KV with a React PWA",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite build && vite preview",
    "deploy": "vite build && wrangler deploy",
    "typecheck": "tsc -p tsconfig.worker.json && tsc -p tsconfig.web.json && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "types": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply encore --local",
    "db:migrate": "wrangler d1 migrations apply encore --remote",
    "db:console": "wrangler d1 execute encore --remote --command",
    "db:console:local": "wrangler d1 execute encore --local --command",
    "tail": "wrangler tail --format pretty"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "hono": "^4.13.13",
    "next-themes": "^0.4.6",
    "shadcn": "^4.21.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.5",
    "@cloudflare/workers-types": "^5.20261006.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.1",
    "@types/node": "^24.19.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "lucide-react": "^1.52.0",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "wrangler": "^4.147.0"
  }
}
